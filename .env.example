# ============================================
# GPT Image 2 Web - example env vars
# Copy to .env and fill in your real key. DO NOT commit the real .env.
# ============================================

# ---- OpenAI-compatible (Right Code / rightapi.ai) ----
OPENAI_API_KEY=sk-replace-me

# ---- Service bind ----
GPT_IMAGE_2_WEB_HOST=0.0.0.0
GPT_IMAGE_2_WEB_PORT=8787

# ---- Auth (recommended) ----
# Set a long random token here. The UI will ask for it on first visit.
# GPT_IMAGE_2_WEB_TOKEN=
# When this is set you can leave ALLOW_UNAUTHENTICATED off (default safe).
GPT_IMAGE_2_WEB_ALLOW_UNAUTHENTICATED=1

# Comma-separated Host headers accepted (matches require_auth policy)
GPT_IMAGE_2_WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Data dirs (container paths) ----
GPT_IMAGE_2_DATA_DIR=/data/gpt-image-2
GPT_IMAGE_2_ALLOWED_DATA_ROOTS=/data/gpt-image-2
XDG_CONFIG_HOME=/data/config
CODEX_HOME=/data/codex

# ---- Config file path (relative to data dir on host) ----
GPT_IMAGE_2_CONFIG_FILE=/data/gpt-image-2/config.json

# ---- Default provider ----
# right-codes / right-codes-vip — matches keys in data/config.json
DEFAULT_PROVIDER=right-codes
